SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Omit both to use the in-process store (LEDGER_STORE=memory).
# Set LEDGER_STORE=memory to force that store even when Supabase is configured.
LEDGER_STORE=

# Required for text-embedding-3-small. Without it, embeddings use local-hash-1536
# and are stored under that model name so they never mix with OpenAI vectors.
OPENAI_API_KEY=

# Required for reflect when a failure is contributed without a lesson draft.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Bearer token required on /api/mcp. Requests are rejected when this is empty.
MCP_ACCESS_TOKEN=

# Lane B: execution adapter (test = in-process fake, freestyle = real VM)
EXECUTION_ADAPTER=test
FREESTYLE_API_KEY=your-freestyle-api-key
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
WEBARENA_SNAPSHOT_SLUG=agent-ledger-webarena
WEBARENA_TASK_ID=
